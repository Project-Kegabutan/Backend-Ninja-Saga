entity character_element_point{
    character_element_id : bigint(255) <<PK, INDEX>>
    --
    character_skill_ap : int
    character_element_fire : int
    character_element_water : int
    character_element_wind : int
    character_element_earth : int
    character_element_lightning : int

    character_id : bigint <<FK>>
}

