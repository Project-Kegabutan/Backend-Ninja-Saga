@startuml ninja saga


entity accounts {
    account_id : bigint(36) <<PK,INDEX>>
    --
    username : varchar(255) <<REQUIRED>>
    password : varchar(255)  <<REQUIRED>>
    email : varchar(255)  <<REQUIRED>>
    account_type : Integer(10) <<REQUIRED>>
    account_session_key :  varchar(255)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity character_token {
    id_token : bigint(255) <<PK,INDEX>>
    --
    username : varchar(255) <<REQUIRED>>
    balance_token : varchar(255) <<INDEX>>
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    account_id : int <<FK>>
}

entity character_list {
    character_id : bigint(255) <<PK, INDEX>>
    --
    character_name : varchar(255)
    character_level : int(10)
    character_gender : int(10)
    character_exp : varchar(255)
    character_gold : int(20)
    character_hp : int(20)
    character_max_hp : int(20)
    character_cp : int(20)
    character_max_cp : int(20)
    character_skill_type : varchar(255)
    account_id : int <<FK>>
}

entity bloodline{
    bloodline_id : bigint(255) <<PK, INDEX>>
    --
    character_id : bigint <<FK>>
}


entity character_bloodline{
    character_bloodline_id : bigint(255) <<PK, INDEX>>
